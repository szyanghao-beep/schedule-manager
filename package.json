{
  "name": "schedule-manager",
  "productName": "日程管理",
  "version": "2.3.5",
  "description": "轻量化、极简风格的日程任务管理工具",
  "main": "main.js",
  "author": "hao.yang",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:ui": "node --test test/ui.*.test.js",
    "smoke": "electron scripts/electron-smoke.js",
    "verify:asar": "node scripts/verify-asar.js",
    "verify:packaged": "node scripts/verify-packaged.js",
    "verify:all": "npm test && npm run test:ui && npm run smoke && npm run verify:asar && npm run verify:packaged",
    "dist": "electron-builder --publish never",
    "dist:dir": "electron-builder --dir",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1"
  },
  "build": {
    "appId": "com.schedule.manager",
    "productName": "日程管理",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "shared/**/*",
      "ai/**/*",
      "server/src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "schedule-manager-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "日程管理 ${version}",
      "artifactName": "schedule-manager-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "schedule-manager-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lunar-javascript": "^1.7.7",
    "nodemailer": "^9.0.5"
  }
}
