# 依赖
node_modules/

# 打包产物
dist/

# 日志与系统文件
*.log
.DS_Store
Thumbs.db

# 本地安装包目录（手动存放的安装包，不入库）
安装包/

# 本地数据备份
日程数据备份-*.json

# 后端运行时数据库
server/data.db
server/data.db-*
server/*.db

# 后端自动生成的 JWT 密钥（含敏感信息，不入库）
server/.secret

# 本地发布目录（安装程序 + 发布文档，走 GitHub Release / 本地交付，不入库）
发布/

# 本地 npm 镜像配置（环境相关，不入库）
.npmrc

# E2E / 冒烟测试临时产物
.e2e-probe.png
.e2e-shots/
.smoke-userdata/
